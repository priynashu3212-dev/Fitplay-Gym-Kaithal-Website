{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "cd artifacts/fitplay-gym-kaithal && PORT=3000 BASE_PATH=/ NODE_ENV=production pnpm build",
  "outputDirectory": "artifacts/fitplay-gym-kaithal/dist/public",
  "rewrites": [{ "source": "/((?!.*\\.\\w+).*)", "destination": "/index.html" }]
}